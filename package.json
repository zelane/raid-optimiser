{
  "name": "raid-optimiser-web",
  "private": true,
  "type": "module",
  "description": "The web UI's front end (Vite + Vue 3 + Inertia, in webui/frontend) and its tooling: stylelint over webui/static.",
  "scripts": {
    "dev": "vite --config webui/frontend/vite.config.ts",
    "build": "vite build --config webui/frontend/vite.config.ts",
    "typecheck": "vue-tsc --noEmit -p webui/frontend",
    "lint:css": "stylelint \"webui/static/*.css\""
  },
  "dependencies": {
    "@inertiajs/vue3": "3.11.0",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/tsconfig": "0.9.1",
    "postcss-html": "2.0.1",
    "prettier": "3.10.1",
    "stylelint": "18.0.0",
    "stylelint-config-clean-order": "10.0.0",
    "stylelint-config-standard": "41.0.0",
    "stylelint-order": "8.1.3",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vue-tsc": "3.3.14"
  }
}
