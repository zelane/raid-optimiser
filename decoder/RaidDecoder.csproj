<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>raid-decoder</AssemblyName>
    <RollForward>Major</RollForward>
    <!-- HellHades extractor install dir: HH_DIR, which just exports (or -p:HHDir=/path/to/hh) -->
    <HHDir Condition="'$(HHDir)' == ''">$(HH_DIR)</HHDir>
  </PropertyGroup>

  <!-- Compile against the MessagePack build the HH install ships.
       Private=false: we don't copy them; they're loaded from HHDir at runtime
       (no NuGet package needed). -->
  <ItemGroup>
    <Reference Include="MessagePack">
      <HintPath>$(HHDir)/MessagePack.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MessagePack.Annotations">
      <HintPath>$(HHDir)/MessagePack.Annotations.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DefaultHHDir</_Parameter1>
      <_Parameter2>$(HHDir)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
