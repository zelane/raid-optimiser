# Machine-specific paths, read by just: `just configure` writes .env (or copy this). Both have defaults in the justfile.
# The game's Proton prefix (Steam → compatdata/<id>/pfx)
RAID_PREFIX=$HOME/.local/share/Steam/steamapps/compatdata/2441943673/pfx
# The HH extractor install (default: $RAID_PREFIX/drive_c/hh; HH's installer puts it in
# $RAID_PREFIX/drive_c/users/steamuser/AppData/Roaming/HellHades Artifact Extractor)
# HH_DIR=
# The Proton the game runs under: `just read` runs the reader with it in the game's umu
# container (default: GE-Proton11-11 in Steam's compatibilitytools.d), unless plarium-umu is on PATH
# RAID_PROTON=
# The web UI's port (just web; default 8000)
# WEB_PORT=8000
